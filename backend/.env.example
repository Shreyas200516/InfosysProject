# ---- Database: leave SUPABASE_* empty to use local SQLite (backend/data/supportpilot.db) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server-side only. NEVER put this in the frontend.
SQLITE_PATH=

# ---- Auth ----
AUTH_SECRET=                    # long random string. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
TOKEN_TTL_HOURS=12

# ---- LLM: Claude by default. With no key the grounded offline engine is used. ----
LLM_PROVIDER=auto               # auto | anthropic | openai | groq | offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-sonnet-4-5
LLM_ALLOW_OFFLINE_FALLBACK=true # if the cloud call fails, fall back to the offline grounded engine

# ---- Retrieval ----
RAG_TOP_K=3
AUTO_RESOLVE_MIN_CONFIDENCE=0.50

# ---- Jira (mock works offline) ----
JIRA_MODE=mock                  # mock | real
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SUP

# ---- Email (mock stores messages and shows them in the UI) ----
EMAIL_MODE=mock                 # mock | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=supportpilot@yourcompany.com

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
